# Copiá este archivo como .env (en esta misma carpeta) y completá tus keys.
# El .env está en el .gitignore: nunca se sube al repo.

# --- LLM de los agentes (anthropic | openai) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Solo si tu key de Anthropic NO está asociada a un workspace
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Base de conocimiento del Investigador: el índice de la pre-entrega 4 ---
# pinecone | local (local = BM25 sobre los archivos del manual, sin Pinecone ni OpenAI)
RESEARCH_BACKEND=pinecone
PINECONE_API_KEY=pcsk_...
OPENAI_API_KEY=sk-...
INDEX_NAME=ola-erp-docs
PINECONE_NAMESPACE=erp-docs-v1

# --- Límites del flujo ---
MAX_DELEGACIONES=6
RECURSION_LIMIT=40

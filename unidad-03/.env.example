# Copiá este archivo como .env (en esta misma carpeta) y completá tus keys.
# El .env está en el .gitignore: nunca se sube al repo.

# LLM (generación de respuestas)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# Embeddings (indexar y consultar SIEMPRE con el mismo modelo)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional: dejalo vacío con Claude 5.x (rechaza temperature con error 400)
ANTHROPIC_TEMPERATURE=

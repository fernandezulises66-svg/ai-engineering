# Copiá este archivo como .env (en esta misma carpeta) y completá tus keys.
# El .env está en el .gitignore: nunca se sube al repo.

# --- LLM de los agentes ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Base de conocimiento del Investigador (índice de la pre-entrega 4) ---
RESEARCH_BACKEND=pinecone
PINECONE_API_KEY=pcsk_...
OPENAI_API_KEY=sk-...
INDEX_NAME=ola-erp-docs
PINECONE_NAMESPACE=erp-docs-v1

# --- Redis (con docker compose lo pisa el servicio "redis") ---
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=5
WORKER_EMBEDDED=true

# --- Observabilidad: Arize Phoenix (con docker compose lo pisa el servicio "phoenix") ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=ola-erp-orquestador

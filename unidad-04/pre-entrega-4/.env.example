# Copiá este archivo como .env (en esta misma carpeta) y completá tus keys.
# El .env está en el .gitignore: nunca se sube al repo.

PINECONE_API_KEY=pcsk_...
OPENAI_API_KEY=sk-...

# Nombre del índice serverless (se crea solo si no existe)
INDEX_NAME=ola-erp-docs

# Opcionales (estos son los valores por defecto)
PINECONE_NAMESPACE=erp-docs-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Copiá este archivo como .env (en esta misma carpeta) y completá tu key.
# El .env está en el .gitignore: nunca se sube al repo.

# Proveedor del LLM: anthropic | openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
# Solo si tu key de Anthropic NO está asociada a un workspace
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5

# Si usás OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Techo de pasos del grafo por turno (evita bucles y costos inesperados)
RECURSION_LIMIT=10

# Copiá este archivo como .env (en esta misma carpeta) y completá tu key.
# El .env está en el .gitignore: nunca se sube al repo.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar (por defecto claude-haiku-5-5, rápido y barato para extracción)
ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional: temperature. Dejalo vacío con los modelos Claude 5.x:
# no aceptan sampling params y devuelven error 400 si se envían.
ANTHROPIC_TEMPERATURE=

# Copiá este archivo como .env (en esta misma carpeta) y completá tus keys.
# El .env está en el .gitignore: nunca se sube al repo.

# Proveedor activo: openai | anthropic
LLM_PROVIDER=anthropic

# API keys (alcanza con la del proveedor que vayas a usar)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Solo si tu key de Anthropic NO está asociada a un workspace (error 400 'anthropic-workspace-id')
ANTHROPIC_WORKSPACE_ID=

# Modelos (opcionales; estos son los valores por defecto)
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-5-5

# Parámetros del modelo (validados con Pydantic)
LLM_TEMPERATURE=        # 0 a 2. Vacío = valor por defecto del proveedor (recomendado con modelos de razonamiento y Claude 5.x)
LLM_MAX_TOKENS=1024     # mínimo 16, máximo 32000
LLM_MAX_RETRIES=2       # reintentos ante rate limit o errores de red
